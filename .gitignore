# FurrGuard - Git Ignore File

# Environment variables (CRITICAL - Contains encryption keys)
.env
.env.local
.env.production

# PHP
/vendor/
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / local assistant settings
.idea/
.vscode/
.claude/
*.swp
*.swo
*~
.DS_Store

# Build outputs
build/
dist/
.gradle/
*.class
*.tsbuildinfo
*.jar
# the Gradle wrapper must be committed or the modules can't build from a clone
!**/gradle/wrapper/gradle-wrapper.jar

# The Velocity plugin is its own git repository (github.com/grinchhorizon/FurrGuard-Plugin)
/FurrGuard-plugin/

# Temporary files
tmp/
temp/
*.tmp
*.cache

# Database dumps/backups (never commit production data)
*.sql
*.sql.gz
backups/

# GeoLite2 databases are downloaded on the server, not versioned
*.mmdb

# Logs
logs/

# OS
Thumbs.db
desktop.ini

# Project specific
config/database.local.php
generate_credentials.php
