# Panel (Apache). El .htaccess de una subcarpeta sustituye las reglas de reescritura de la raíz.
RewriteEngine On

# Código fuente y configuración del SPA
RewriteRule ^(src|node_modules)(/|$) - [F,L]

# Assets compilados por Vite (el HTML los pide en /admin/assets/)
RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

# Endpoints PHP del panel
RewriteRule ^(api|callback|index)\.php$ - [L]

# Resto de rutas del SPA (modo historial) → index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
