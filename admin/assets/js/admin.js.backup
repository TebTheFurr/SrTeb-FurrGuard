async function deleteProvider(id) {
    const confirmed = await showConfirm('¿Estás seguro de eliminar este proveedor?');
    if (!confirmed) return;

    try {
        const response = await apiRequest('remove_provider', { action: 'delete_provider', id });
        if (response.success) {
            await loadProvidersData();
        await showAlert('Proveedor eliminado correctamente', 'Éxito', 'success');
        } else {
            await showAlert(response.error || 'Error al eliminar', 'Error', 'danger');
        }
    } catch (error) {
        await showAlert('Error al eliminar proveedor', 'Error', 'danger');
    }
}

