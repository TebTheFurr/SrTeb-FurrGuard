function renderMessagesTable(messages) {
    const tbody = document.getElementById('messagesTableBody');
    if (!tbody) return;

    Object.entries(messages).forEach(([key, value]) => {
        const row = document.createElement('tr');
        row.innerHTML = `
            <td class="message-key">${key}</td>
            <td><textarea class="message-input" id="msg-${key}">${escapeHtml(value)}</textarea></td>
            <td class="actions-cell">
                <button class="btn-primary btn-sm" onclick="saveMessage('${key}')">Guardar</button>
            </td>
        `;
        tbody.appendChild(row);
    });
}

function renderSettingsTable(settings) {
    const tbody = document.getElementById('settingsTableBody');
    if (!tbody) return;

    Object.entries(settings).forEach(([key, value]) => {
        const row = document.createElement('tr');
        const isApiKey = key === 'api_key';
        const isWebhook = key === 'webhook_url';
        const isBoolean = ['block_proxy', 'block_vpn', 'block_hosting', 'notify_connections', 'notify_hispanic', 'notify_blocks'].includes(key);

        row.innerHTML = `
            <td>
                <code>${key}</code>
            </td>
            <td>
                ${isApiKey
                    ? '<input type="password" class="settings-input" id="setting-${key}" value="•••••••••••••" onchange="markSettingsChanged()">'
                    : isBoolean
                        ? `<select class="settings-input" id="setting-${key}" onchange="markSettingsChanged()">
                                <option value="1"${value === '1' ? 'selected' : ''}>Sí</option>
                                <option value="0"${value === '0' ? 'selected' : ''}>No</option>
                            </select>`
                        : `<input type="text" class="settings-input" id="setting-${key}" value="${escapeHtml(value)}" onchange="markSettingsChanged()">`
                    }
            </td>
            <td class="actions-cell">
                ${isWebhook ? `
                    <button class="btn-icon btn-warning" onclick="testWebhook()">Test</button>
                ` : ''}
                ${isApiKey ? `
                    <button class="btn-icon btn-secondary" onclick="regenerateApiKey()">Regenerar</button>
                ` : ''}
            </td>
        `;
        tbody.appendChild(row);
    });

    // Hide server_name and discord_url from display, only show through edit modal
    const serverNameRow = tbody.querySelector(`tr:has-código(code: "server_name")`);
    const discordUrlRow = tbody.querySelector(`tr:has-código(code: "discord_url")`);
    if (serverNameRow) serverNameRow.style.display = 'none';
    if (discordUrlRow) discordUrlRow.style.display = 'none';
}

function renderUsersTable(users) {
    const tbody = document.getElementById('usersTableBody');
    if (!tbody) return;

    if (users.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="empty-state">No hay usuarios admin</td></tr>';
        return;
    }

    tbody.innerHTML = users.map(user => {
        const roleLabels = { founder: 'Founder', owner: 'Owner', manager: 'Manager', sradmin: 'SrAdmin', admin: 'Admin' };
        const badgeClass = user.role === 'founder' ? 'badge-founder' : 'badge-admin';

        return `
            <tr>
                <td>${user.discord_id}</td>
                <td><span class="badge ${badgeClass}">${roleLabels[user.role] || user.role}</span></td>
                <td>${user.created_by || '-'}</td>
                <td>${formatDateTime(user.created_at)}</td>
                <td class="actions-cell">
                    ${(user.role !== 'founder') ? `
                        <button class="btn-icon btn-danger" onclick="removeAdminUser(${user.id})" title="Eliminar">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2 2v2"></path></svg>
                        </button>
                    ` : '<span class="text-muted">—</span>'}
                </td>
            </tr>
        `;
    }).join('');
}

async function editWhitelistEntry(id) {
    const type = await showPrompt('Tipo', '', 'uuid, nick, ip, as, ip_range');
    const value = await showPrompt('Valor');
    const reason = await showPrompt('Razón (opcional)');

    if (!type || !value) {
        await showAlert('Tipo y valor son requeridos', 'Campo requerido', 'warning');
        return;
    }

    try {
        const response = await apiRequest('edit_whitelist', { id, type, value, reason });
        if (response.success) {
            await showAlert('Entrada actualizada correctamente', 'Éxito', 'success');
            await loadWhitelistData();
        }
    } catch (error) {
        await showAlert('Error al actualizar entrada', 'Error', 'danger');
    }
}

async function removeWhitelist(id) {
    const confirmed = await showConfirm('¿Estás seguro de eliminar esta entrada?');
    if (!confirmed) return;

    try {
        const response = await apiRequest('remove_whitelist', { id });
        if (response.success) {
            await showAlert('Entrada eliminada correctamente', 'Éxito', 'success');
            await loadWhitelistData();
        }
    } catch (error) {
        await showAlert('Error al eliminar', 'Error', 'danger');
    }
}

async function toggleBlacklist(id, active) {
    try {
        const response = await apiRequest('toggle_blacklist', { id, active });
        if (response.success) {
            await showAlert(active ? 'Entrada activada' : 'Entrada desactivada', 'Éxito', 'success');
            await loadBlacklistData();
        }
    } catch (error) {
        await showAlert('Error al cambiar estado', 'Error', 'danger');
    }
}

async function removeBlacklist(id) {
