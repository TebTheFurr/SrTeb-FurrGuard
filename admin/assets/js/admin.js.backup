function getBlockReasonLabel(reason) {
    const labels = {
        'proxy_detected': 'Proxy',
        'vpn_detected': 'VPN',
        'hosting_detected': 'Hosting',
        'blacklisted': 'Blacklist',
        'blocked_provider': 'ISP Bloqueado'
    };
    return labels[reason] || reason || 'Bloqueado';
}

function getMessageDescription(key) {
    const descriptions = {
        'prefix': 'Prefijo que aparece antes de todos los mensajes',
        'kick_proxy': 'Mensaje al detectar conexión desde proxy',
        'kick_vpn': 'Mensaje al detectar conexión desde VPN',
        'kick_hosting': 'Mensaje al detectar conexión desde hosting/datacenter',
        'kick_blacklisted': 'Mensaje cuando el jugador está en blacklist',
        'kick_blocked_provider': 'Mensaje cuando el ISP está bloqueado',
        'whitelist_added': 'Confirmación al añadir a whitelist',
        'whitelist_removed': 'Confirmación al quitar de whitelist',
        'blacklist_added': 'Confirmación al añadir a blacklist',
        'blacklist_removed': 'Confirmación al quitar de blacklist',
        'player_allowed': 'Log cuando un jugador es permitido',
        'player_blocked': 'Log cuando un jugador es bloqueado',
        'no_permission': 'Sin permisos para comando',
        'reload_success': 'Recarga exitosa',
        'command_usage': 'Uso incorrecto de comando',
        'player_not_found': 'Jugador no encontrado',
        'invalid_type': 'Tipo inválido en comando'
    };
    return descriptions[key] || '';
}

function getLogIconClass(type) {
    const classes = {
        'whitelist': 'green',
        'blacklist': 'red',
        'connection': 'blue',
        'settings': 'orange'
    };
    return classes[type] || 'blue';
}

function getLogIcon(type) {
    const icons = {
        'whitelist': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
        'blacklist': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg>',
        'connection': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>',
        'settings': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6"/></svg>'
    };
    return icons[type] || icons['connection'];
}

// ============================================
// FURRPERMS MODULE
// ============================================

let furrPermsState = {
    whitelist: [],
    logs: [],
    stats: { total_whitelist: 0, allowed_commands: 0, blocked_commands: 0 },
    currentPage: 1,
    perPage: 20,
    filter: 'all',
    search: ''
};

async function initFurrPerms() {
    // Check permissions
    if (!checkPermission('furrperms')) {
        showNotification('No tienes permiso para acceder a esta sección', 'error');
        return;
    }

    // Event listeners
    document.getElementById('addFurrPermsWhitelistBtn')?.addEventListener('click', () => openFurrPermsModal());
    document.getElementById('refreshFurrPermsBtn')?.addEventListener('click', () => loadFurrPermsData());
    document.getElementById('clearFurrPermsLogsBtn')?.addEventListener('click', () => clearFurrPermsLogs());
    document.getElementById('searchFurrPermsWhitelist')?.addEventListener('input', (e) => {
        furrPermsState.search = e.target.value;
        renderFurrPermsWhitelist();
    });
    document.getElementById('searchFurrPermsLogs')?.addEventListener('input', (e) => {
        furrPermsState.search = e.target.value;
        renderFurrPermsLogs();
    });
    document.getElementById('furrPermsLogsFilter')?.addEventListener('change', (e) => {
        furrPermsState.filter = e.target.value;
        furrPermsState.currentPage = 1;
        loadFurrPermsLogs();
    });
    document.getElementById('confirmAddFurrPermsWhitelist')?.addEventListener('click', addFurrPermsWhitelist);

    // Load initial data
    await loadFurrPermsData();
}

async function loadFurrPermsData() {
    await Promise.all([
        loadFurrPermsWhitelist(),
        loadFurrPermsLogs()
    ]);
    loadFurrPermsStats();
}

async function loadFurrPermsWhitelist() {
    try {
        const response = await fetch('api.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ action: 'get_furr_perms_whitelist' })
        });
        const data = await response.json();
        if (data.success) {
            furrPermsState.whitelist = data.entries;
            renderFurrPermsWhitelist();
        }
    } catch (error) {
        console.error('Error loading FurrPerms whitelist:', error);
    }
}

async function loadFurrPermsLogs() {
    try {
        const params = new URLSearchParams({
            action: 'get_furr_perms_logs',
            page: furrPermsState.currentPage,
            per_page: furrPermsState.perPage
        });
        if (furrPermsState.filter !== 'all') {
            params.append('filter', furrPermsState.filter);
        }
        if (furrPermsState.search) {
            params.append('search', furrPermsState.search);
        }

        const response = await fetch('api.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: params
        });
        const data = await response.json();
        if (data.success) {
            furrPermsState.logs = data.logs;
            furrPermsState.stats = {
                total_whitelist: data.stats?.total_whitelist || 0,
                allowed_commands: data.stats?.allowed_commands || 0,
                blocked_commands: data.stats?.blocked_commands || 0
            };
            renderFurrPermsLogs();
            renderFurrPermsStats();
            renderFurrPermsPagination(data.total_pages, data.current_page);
        }
    } catch (error) {
        console.error('Error loading FurrPerms logs:', error);
    }
}

function loadFurrPermsStats() {
    document.getElementById('furrPermsTotalWhitelist').textContent = furrPermsState.whitelist.length;
    document.getElementById('furrPermsAllowedCommands').textContent = furrPermsState.stats.allowed_commands;
    document.getElementById('furrPermsBlockedCommands').textContent = furrPermsState.stats.blocked_commands;
}

function renderFurrPermsStats() {
    document.getElementById('furrPermsTotalWhitelist').textContent = furrPermsState.stats.total_whitelist;
    document.getElementById('furrPermsAllowedCommands').textContent = furrPermsState.stats.allowed_commands;
    document.getElementById('furrPermsBlockedCommands').textContent = furrPermsState.stats.blocked_commands;
}

function renderFurrPermsWhitelist() {
    const tbody = document.getElementById('furrPermsWhitelistTableBody');
    if (!tbody) return;

    const filtered = furrPermsState.whitelist.filter(entry =>
        !furrPermsState.search ||
        entry.nick.toLowerCase().includes(furrPermsState.search.toLowerCase()) ||
        (entry.uuid && entry.uuid.toLowerCase().includes(furrPermsState.search.toLowerCase())) ||
        (entry.added_by && entry.added_by.toLowerCase().includes(furrPermsState.search.toLowerCase()))
    );

    if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="empty-state">No hay jugadores en whitelist</td></tr>';
        return;
    }

    tbody.innerHTML = filtered.map(entry => `
        <tr class="${entry.active ? '' : 'row-disabled'}">
            <td>
                <span class="player-name">${escapeHtml(entry.nick)}</span>
                ${!entry.active ? '<span class="badge badge-secondary">Inactivo</span>' : ''}
            </td>
            <td><span class="text-muted">${entry.uuid ? escapeHtml(entry.uuid.substring(0, 8) + '...') : '-'}</span></td>
            <td>${entry.reason ? escapeHtml(entry.reason) : '-'}</td>
            <td>${escapeHtml(entry.added_by)}</td>
            <td>${formatDate(entry.created_at)}</td>
            <td>
                <button class="btn-icon btn-danger" onclick="removeFurrPermsWhitelist(${entry.id}, '${escapeHtml(entry.nick)}')" title="Eliminar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 12 20"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                </button>
            </td>
        </tr>
    `).join('');
}

function renderFurrPermsLogs() {
    const tbody = document.getElementById('furrPermsLogsTableBody');
    if (!tbody) return;

    if (furrPermsState.logs.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="empty-state">No hay logs registrados</td></tr>';
        return;
    }

    tbody.innerHTML = furrPermsState.logs.map(log => `
        <tr>
            <td>
                <span class="player-name">${escapeHtml(log.player_nick)}</span>
            </td>
            <td><code class="command-code">${escapeHtml(log.command)}</code></td>
            <td>${escapeHtml(log.server_name || '-')}</td>
            <td>
                <span class="badge ${log.allowed ? 'badge-success' : 'badge-danger'}">
                    ${log.allowed ? 'Permitido' : 'Bloqueado'}
                </span>
            </td>
            <td>${formatDateTime(log.created_at)}</td>
        </tr>
    `).join('');
}

function renderFurrPermsPagination(totalPages, currentPage) {
    const container = document.getElementById('furrPermsLogsPagination');
    if (!container) return;

    if (totalPages <= 1) {
        container.innerHTML = '';
        return;
    }

    let html = '';
    for (let i = 1; i <= totalPages; i++) {
        html += `<button class="pagination-btn ${i === currentPage ? 'active' : ''}" onclick="goToFurrPermsPage(${i})">${i}</button>`;
    }
    container.innerHTML = html;
}

function goToFurrPermsPage(page) {
    furrPermsState.currentPage = page;
    loadFurrPermsLogs();
}

function openFurrPermsModal() {
    const modal = document.getElementById('addFurrPermsModal');
    if (modal) {
        modal.classList.add('active');
        document.getElementById('furrPermsNick').value = '';
        document.getElementById('furrPermsUuid').value = '';
        document.getElementById('furrPermsReason').value = '';
    }
}

async function addFurrPermsWhitelist() {
    const nick = document.getElementById('furrPermsNick').value.trim();
    const uuid = document.getElementById('furrPermsUuid').value.trim();
    const reason = document.getElementById('furrPermsReason').value.trim();

    if (!nick) {
        showNotification('El nick es obligatorio', 'error');
        return;
    }

    if (uuid && !isValidUUID(uuid)) {
        showNotification('UUID inválido', 'error');
        return;
    }

    try {
        const response = await fetch('api.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
                action: 'add_furr_perms_whitelist',
                nick: nick,
                uuid: uuid,
                reason: reason
            })
        });
        const data = await response.json();

        if (data.success) {
            showNotification('Jugador añadido a whitelist', 'success');
            closeModal('addFurrPermsModal');
            await loadFurrPermsWhitelist();
        } else {
            showNotification(data.error || 'Error al añadir jugador', 'error');
        }
    } catch (error) {
        console.error('Error adding FurrPerms whitelist:', error);
        showNotification('Error al añadir jugador', 'error');
    }
}

async function removeFurrPermsWhitelist(id, nick) {
    if (!confirm(`¿Eliminar a ${nick} de la whitelist?`)) return;

    try {
        const response = await fetch('api.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
                action: 'remove_furr_perms_whitelist',
                id: id
            })
        });
        const data = await response.json();

        if (data.success) {
            showNotification('Jugador eliminado de whitelist', 'success');
            await loadFurrPermsWhitelist();
        } else {
            showNotification(data.error || 'Error al eliminar', 'error');
        }
    } catch (error) {
        console.error('Error removing FurrPerms whitelist:', error);
        showNotification('Error al eliminar', 'error');
    }
}

async function clearFurrPermsLogs() {
    if (!confirm('¿Limpiar logs antiguos (más de 30 días)?')) return;

    try {
        const response = await fetch('api.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ action: 'clear_furr_perms_logs' })
        });
        const data = await response.json();

        if (data.success) {
            showNotification(`${data.deleted} logs eliminados`, 'success');
            await loadFurrPermsLogs();
        } else {
            showNotification(data.error || 'Error al limpiar logs', 'error');
        }
    } catch (error) {
        console.error('Error clearing FurrPerms logs:', error);
        showNotification('Error al limpiar logs', 'error');
    }
}

function isValidUUID(uuid) {
    const regex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
    return regex.test(uuid);
}

async function exportData() {
    try {
        const response = await apiRequest('export_data');
        if (response.success) {
            const blob = new Blob([JSON.stringify(response.data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `furrguard_export_${new Date().toISOString().split('T')[0]}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('Datos exportados', 'success');
        }
    } catch (error) {
        showToast('Error al exportar', 'error');
    }
}

