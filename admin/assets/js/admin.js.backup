                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">${continent.active ? '<circle cx="12" cy="12" r="10"/>' : '<circle cx="12" cy="12" r="10" fill="none" stroke="currentColor"/>'}</svg>
