async function editCountry(id) {
    const kickMessage = await showPrompt('Mensaje de kick (opcional)');
    const name = await showPrompt('Nombre del país', '');
    const code = await showPrompt('Código del país', '');

    if (!code || !name) {
        await showAlert('Código y nombre son requeridos', 'Campo requerido', 'warning');
        return;
    }

    try {
        const response = await apiRequest('edit_country', { id, kick_message: kickMessage, country_name: name, country_code: code });
        if (response.success) {
            await showAlert('País actualizado correctamente', 'Éxito', 'success');
            await loadCountriesData();
        }
    } catch (error) {
        await showAlert('Error al actualizar país', 'Error', 'danger');
    }
}

