# FurrGuard — variables de entorno (docs/API.md §8)
# Copia este archivo a .env, rellénalo y protégelo: chmod 600 .env
# Una variable definida en el entorno real (PHP-FPM, systemd) tiene prioridad sobre este archivo.
# Admite comentarios con # y valores entre comillas ("con espacios" o 'literales').

# ── Aplicación ─────────────────────────────────────────────────────────────
# production | development. development muestra errores en pantalla y permite el servidor de
# desarrollo de Vite (localhost:5173) en la CSP. Nunca uses development en el servidor público.
APP_ENV=production
# URL pública, sin barra final. Define el origen permitido del panel, la cookie Secure (si es
# https), HSTS y las URL de redirección de Discord y de verificación. Obligatoria.
APP_URL=https://furrguard.srteb.eu

# ── Base de datos (MariaDB 10.3+ / MySQL 5.7+) ─────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=furrguard
DB_USERNAME=furrguard_user
DB_PASSWORD=

# ── Discord OAuth (panel y verificación de staff) ──────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Si se deja vacía se usa APP_URL/admin/callback.php. Debe coincidir con el portal de Discord.
DISCORD_REDIRECT_URI=https://furrguard.srteb.eu/admin/callback.php
# ID de Discord con rol founder siempre (aunque no esté en admin_users).
FOUNDER_DISCORD_ID=

# ── Red ────────────────────────────────────────────────────────────────────
# Solo si hay un proxy inverso PROPIO delante de PHP: IPs o CIDR separados por comas
# (p. ej. 127.0.0.1,10.0.0.0/8). Cloudflare se detecta solo por sus rangos oficiales.
# X-Forwarded-For se recorre de derecha a izquierda saltando estos proxies.
TRUSTED_PROXIES=
# Peticiones por minuto por API key (plugin y módulos). Todo el tráfico de la red sale de la
# IP del proxy, por eso no hay límite por IP para tráfico autenticado.
API_RATE_LIMIT_PER_MIN=6000

# ── Geolocalización: espejo local MaxMind GeoLite2 ─────────────────────────
# Rutas relativas a la raíz del proyecto o absolutas. Si faltan los archivos, el espejo se
# desactiva sin errores (el panel lo indica en el resumen).
GEOIP_COUNTRY_DB=storage/geoip/GeoLite2-Country.mmdb
GEOIP_ASN_DB=storage/geoip/GeoLite2-ASN.mmdb
# Cuenta gratuita en https://www.maxmind.com/en/geolite2/signup → License key.
# Las usa bin/geoip-update.php (cron dos veces por semana).
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
