parameters:
    level: 6
    # Todo el PHP del proyecto (plataforma, dominio y puntos de entrada).
    paths:
        - config.php
        - config
        - includes
        - bin
        - database
        - tests/php
        - index.php
        - verify.php
        - api
        - admin/index.php
        - admin/callback.php
        - admin/api.php
        - admin/api
    bootstrapFiles:
        - tests/php/phpstan-bootstrap.php
    # Constantes que dependen del entorno: PHPStan no debe asumir su valor.
    dynamicConstantNames:
        - APP_ENV
        - APP_URL
        - DISCORD_CLIENT_ID
        - DISCORD_CLIENT_SECRET
        - DISCORD_REDIRECT_URI
        - FOUNDER_DISCORD_ID
        - PTERODACTYL_URL
        - PTERODACTYL_PANEL_KEY
        - PTERODACTYL_PANEL_IPS
        - FURRGUARD_STORAGE
        - FURRGUARD_SKIP_DOTENV
    typeAliases:
        # Usuario del panel devuelto por adminSessionValidate() (includes/admin_session.php).
        AdminUser: 'array{discord_id: string, username: ?string, avatar: ?string, role: string, session_id: int}'
        # Reglas de detección cargadas por detectionRules() (includes/detection.php).
        DetectionRules: 'array{settings: array<string, ?string>, providers: array<string, array{keys: array<string, int>, max_tokens: int}>, countries: array<string, int>, continents: array<string, int>}'
